[Unit]
Description=IOT2050 Module Firmware gRPC service
ConditionFirmware=device-tree-compatible(siemens,iot2050-advanced-sm)
Requires=iot2050-eiofsd.service
After=iot2050-eiofsd.service
BindsTo=iot2050-eiofsd.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -u -m iot2050_module_firmware_update --grpc-server
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=2
TimeoutStopSec=infinity
KillMode=control-group

[Install]
WantedBy=multi-user.target