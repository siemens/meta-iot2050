prereqs()
{
	:
}

case $1 in
prereqs)
	prereqs
	exit 0
	;;
esac

. /scripts/functions

# LoaderDevicePartUUID contains the PARTUUID of the ESP partition.
# The variable name and GUID follow the Boot Loader Interface specification.
efivar=/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f

fail()
{
	ROOT=/dev/null
	export ROOT
	echo "ROOT=${ROOT}" >/conf/param.conf
	panic "efi-rootfs: $*"
	exit 1
}

# Read the PARTUUID of the ESP partition from efivarfs.
read_loader_partition_uuid()
{
	mkdir -p /sys/firmware/efi/efivars
	/sbin/modprobe efivarfs 2>/dev/null || true
	mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true
	[ -r "${efivar}" ] || return 1
	dd if="${efivar}" bs=1 skip=4 2>/dev/null | tr -d '\000\r\n'
}

# Resolve a partition device node to its parent disk device node.
partition_to_disk()
{
	partition_sysfs="$(readlink -f "/sys/class/block/${1##*/}" 2>/dev/null)"
	[ -f "${partition_sysfs}/partition" ] || return 1
	disk_sysfs="${partition_sysfs%/*}"
	printf '/dev/%s\n' "${disk_sysfs##*/}"
}

# Find the unique rootfs partition on the specified boot disk.
find_rootfs_on_disk()
{
	boot_disk_sysfs="$(readlink -f "/sys/class/block/${1##*/}" 2>/dev/null)"
	[ -n "${boot_disk_sysfs}" ] || return 1

	rootfs=
	count=0
	for partition in /sys/class/block/*; do
		[ -f "${partition}/partition" ] || continue
		partition_sysfs="$(readlink -f "${partition}" 2>/dev/null)"
		[ "${partition_sysfs%/*}" = "${boot_disk_sysfs}" ] || continue
		device="/dev/${partition_sysfs##*/}"
		[ -b "${device}" ] || continue

		partlabel="$(blkid -s PARTLABEL -o value "${device}" 2>/dev/null || true)"
		label="$(blkid -s LABEL -o value "${device}" 2>/dev/null || true)"
		if [ "${partlabel}" = "rootfs" ] || [ "${label}" = "rootfs" ]; then
			rootfs="${device}"
			count=$((count + 1))
		fi
	done

	case ${count} in
	1) printf '%s\n' "${rootfs}" ;;
	0) return 1 ;;
	*) return 2 ;;
	esac
}

# Wait for the ESP partition to appear and reject duplicate PARTUUIDs.
wait_for_loader_partition()
{
	loader_partition_uuid="$1"
	count=0
	while [ "${count}" -lt 15 ]; do
		matches="$(blkid --match-token "PARTUUID=${loader_partition_uuid}" --output device 2>/dev/null || true)"
		set -f
		# shellcheck disable=SC2086
		set -- ${matches}
		set +f
		case $# in
		1)
			printf '%s\n' "$1"
			return 0
			;;
		[2-9]|[1-9][0-9]*) return 2 ;;
		esac
		sleep 1
		count=$((count + 1))
	done
	return 1
}

# Wait for a unique rootfs partition to appear on the boot disk.
wait_for_rootfs()
{
	boot_disk="$1"
	count=0
	while [ "${count}" -lt 15 ]; do
		rootfs="$(find_rootfs_on_disk "${boot_disk}")"
		status=$?
		[ "${status}" -eq 0 ] && {
			printf '%s\n' "${rootfs}"
			return 0
		}
		[ "${status}" -eq 2 ] && return 2
		sleep 1
		count=$((count + 1))
	done
	return 1
}

# Prevent initramfs-tools from resolving an ambiguous PARTLABEL globally.
ROOT=/dev/null
export ROOT
echo "ROOT=${ROOT}" >/conf/param.conf
wait_for_udev 10

# Read the PARTUUID of the ESP partition; fail if it is unavailable.
loader_partition_uuid="$(read_loader_partition_uuid)" ||
	fail "LoaderDevicePartUUID is unavailable"
[ -n "${loader_partition_uuid}" ] || fail "LoaderDevicePartUUID is empty"
loader_partition_uuid="$(printf '%s' "${loader_partition_uuid}" | tr '[:upper:]' '[:lower:]')"

# Find the ESP partition by UUID, waiting for device enumeration.
loader_partition="$(wait_for_loader_partition "${loader_partition_uuid}")"
status=$?
[ "${status}" -eq 2 ] && fail "duplicate loader partition UUID ${loader_partition_uuid}"
[ "${status}" -eq 0 ] || fail "loader partition ${loader_partition_uuid} was not found"

# Resolve the disk containing the ESP partition.
boot_disk="$(partition_to_disk "${loader_partition}")" ||
	fail "cannot determine disk for ${loader_partition}"

# Find the unique rootfs partition on the boot disk, waiting for it to appear.
rootfs="$(wait_for_rootfs "${boot_disk}")"
status=$?
[ "${status}" -eq 2 ] && fail "multiple rootfs partitions found on ${boot_disk}"
[ "${status}" -eq 0 ] || fail "rootfs label not found on ${boot_disk}"

ROOT="${rootfs}"
export ROOT
echo "ROOT=${ROOT}" >/conf/param.conf
echo "efi-rootfs: boot disk=${boot_disk}, selected ROOT=${ROOT}" >&2
