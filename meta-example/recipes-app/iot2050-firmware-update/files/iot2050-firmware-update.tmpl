"""CLI client for the System Firmware gRPC service."""

import argparse
import json
import os
import subprocess
import sys
import tarfile
import textwrap
import time

import grpc

from iot2050_system_firmware_pb2 import (
    OperationRequest,
    RollbackRequest,
    UpdateRequest,
)
from iot2050_system_firmware_pb2_grpc import SystemFirmwareStub
from iot2050_firmware_global import SYSTEM_FIRMWARE_SOCKET_TARGET


SOCKET_TARGET = SYSTEM_FIRMWARE_SOCKET_TARGET
ACTIVE_PROGRESS_STAGES = ("backing-up", "updating-uboot", "updating-env")
PROGRESS_DOT_INTERVAL = 0.4
LINE_STAGES = ACTIVE_PROGRESS_STAGES + ("preparing-rollback",)
# Semantic service error codes mapped to the documented CLI exit codes.
EXIT_CODES = {
    "backup-failed": 3,
    "rollback-failed": 4,
    "flashing-failed": 5,
    "firmware-incompatible": 7,
    "missing-signature": 9,
    "missing-key": 10,
    "bad-signature": 11,
}


def parser():
    description = textwrap.dedent("""\
        Update OSPI firmware.
        Examples:
        1. %(prog)s -f file.bin
             using binary format firmware
        2. %(prog)s  file.tar.xz
             using tarball format firmware
        3. %(prog)s -p "env1,env2" file.tar.xz
             using tarball format firmware, preserve environment follow -p
        4. %(prog)s -r file.tar.xz
             using tarball format firmware, reset environment
        5. %(prog)s -b
             rollback the firmware to the version before the upgrade
        6. %(prog)s --verify file.tar.xz
             perform a regular update, but enforce signature verification for the firmware

        Hardware operations are performed by the privileged gRPC service.
        """)
    epilog = textwrap.dedent("""\
        Return Value:
          | Error code  | Description                              |
          |-------------|------------------------------------------|
          | 0           | Success                                  |
          | 1           | Success to rollback                      |
          | 2           | Failed to parse the arguments            |
          | 3           | Failed to backup firmware                |
          | 4           | Failed to rollback the original firmware |
          | 5           | Flashing error                           |
          | 6           | User canceled                            |
          | 7           | Invalid firmware                         |
          | 8           | Failed to update                         |
          | 9           | Missing firmware signature               |
          | 10          | Missing public key                       |
          | 11          | Bad firmware signature                   |
        """)
    result = argparse.ArgumentParser(
        description=description,
        epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    group = result.add_mutually_exclusive_group()
    result.add_argument("firmware", nargs="?", metavar="FIRMWARE")
    group.add_argument("-f", "--force", action="store_true",
                       help="Force update, ignore package checks")
    group.add_argument("-p", "--preserve_list", type=str,
                       help="Comma-separated U-Boot environment variables")
    group.add_argument("-r", "--reset", action="store_true",
                       help="Reset the U-Boot environment")
    group.add_argument("-b", "--rollback", action="store_true",
                       help="Rollback to the previous firmware")
    result.add_argument("-v", "--version", action="version",
                        version="%(prog)s version: ${PV}")
    result.add_argument("-V", "--verify", action="store_true",
                        help="Enforce firmware signature verification")
    backup_group = result.add_mutually_exclusive_group()
    backup_group.add_argument("-n", "--no-backup", action="store_true",
                              help="Do not generate a firmware backup")
    backup_group.add_argument("-d", "--backup-dir", nargs=1,
                              help="Specify the firmware backup directory")
    result.add_argument("-q", "--quiet", action="store_true",
                        help="Automatically answer prompts, show progress, and do not reboot")
    return result


def confirm(message, quiet, auto_answer="y"):
    if quiet:
        print(f"\033[1m{message} (y/N)?{auto_answer}\033[0m")
        return auto_answer.lower() == "y"
    try:
        return input(f"\033[1m{message} (y/N)? \033[0m").strip().lower() == "y"
    except EOFError:
        return False


def result_code(response, rollback=False):
    if response.ok:
        return 1 if rollback else 0
    return EXIT_CODES.get(response.code, 8)


def absolute_path(value):
    return os.path.abspath(value) if value else ""


def current_board():
    try:
        with open("/sys/firmware/devicetree/base/model", encoding="utf-8") as model:
            return model.read().strip("\0")
    except OSError:
        return None


def package_file(package, name):
    """Find a regular package member with or without a ./ prefix."""
    for member in package.getmembers():
        if member.name.removeprefix("./") == name and member.isfile():
            return package.extractfile(member)
    return None


def preserved_environment(firmware_path, preserve_list):
    """Read the legacy display values without moving update logic into the CLI."""
    if preserve_list:
        names = preserve_list
    else:
        try:
            with tarfile.open(firmware_path, "r:*") as package:
                config_file = package_file(package, "update.conf.json")
                config = json.load(config_file) if config_file else {}
            names = (config.get("suggest_preserved_uboot_env", [])
                     if isinstance(config, dict) else [])
            if not isinstance(names, (list, tuple)):
                names = []
        except (OSError, EOFError, tarfile.TarError, KeyError, TypeError,
                ValueError):
            return []

    values = []
    for name in names:
        if not isinstance(name, str) or not name:
            continue
        try:
            result = subprocess.run(
                ["fw_printenv", name],
                capture_output=True,
                text=True,
                check=True,
                timeout=10,
            )
        except (OSError, subprocess.CalledProcessError,
                subprocess.TimeoutExpired):
            continue
        value = result.stdout.strip()
        if value:
            values.append(value)
    return values


def print_legacy_context():
    board = current_board()
    if board:
        print(f"Current board: {board}\n")


def print_preserved_environment(firmware_path, preserve_list):
    print("Preserved env list:")
    for value in preserved_environment(firmware_path, preserve_list):
        print(value)
    print()


def print_stage(stage, previous_stage, backup):
    if previous_stage in LINE_STAGES and stage != previous_stage:
        print()
    if stage == "preparing-backup" and backup:
        print("\nFirmware backup started")
    elif stage == "backing-up":
        if previous_stage != "preparing-backup":
            print("\nFirmware backup started")
        print("Backing up     ", end="", flush=True)
    elif stage == "flashing-system":
        if backup:
            print("Firmware backup ended\n")
        print(
            "===================================================\n"
            "IOT2050 firmware update started - DO NOT INTERRUPT!\n"
            "==================================================="
        )
    elif stage == "updating-uboot":
        print("Updating uboot ", end="", flush=True)
    elif stage == "updating-env":
        print("Updating env   ", end="", flush=True)
    elif stage == "preparing-rollback":
        print("Preparing rollback", end="", flush=True)
    elif stage == "retrying-flash":
        print("Retrying firmware update")


def wait_for_operation(stub, operation_id, quiet, backup, timeout=3600):
    deadline = time.monotonic() + timeout
    previous_stage = None
    next_progress_at = 0.0
    while True:
        response = stub.GetOperation(
            OperationRequest(operation_id=operation_id), timeout=10
        )
        now = time.monotonic()
        if response.stage != previous_stage:
            print_stage(response.stage, previous_stage, backup)
            previous_stage = response.stage
            if response.stage in ACTIVE_PROGRESS_STAGES:
                next_progress_at = now + PROGRESS_DOT_INTERVAL
        if response.state != "running":
            if previous_stage in LINE_STAGES:
                print()
            return response
        if (previous_stage in ACTIVE_PROGRESS_STAGES and
            now >= next_progress_at):
            print(".", end="", flush=True)
            next_progress_at = now + PROGRESS_DOT_INTERVAL
        if now >= deadline:
            raise TimeoutError("System firmware operation timed out")
        time.sleep(0.2)


def main(argv=None):
    args = parser().parse_args(argv[1:] if argv else None)
    if args.force and (args.no_backup or args.backup_dir or args.verify):
        parser().error("argument -f/--force is not allowed with -n, -d, or --verify")
    if not args.rollback and not args.firmware:
        print("No firmware or action specified. A firmware file is required.",
              file=sys.stderr)
        return 2
    if not args.rollback and not os.path.isfile(absolute_path(args.firmware)):
        print(f"Firmware file not found: {args.firmware}", file=sys.stderr)
        return 2
    preserve_list = list(dict.fromkeys(
        item.strip() for item in (args.preserve_list or "").split(",")
        if item.strip()
    ))
    if not args.rollback and not args.force:
        print_legacy_context()
    if not confirm("\nWarning: Update may render device unbootable. Continue",
                   args.quiet):
        return 6
    if args.reset and not confirm(
            "\nWarning: All U-Boot environment variables will be reset to"
            " factory settings. Continue",
            args.quiet):
        return 6
    if args.rollback and not confirm(
            "\nRollback the firmware to the version before the upgrade",
            args.quiet):
        return 6
    if not args.rollback and not args.force and not args.reset:
        print_preserved_environment(absolute_path(args.firmware), preserve_list)

    channel = grpc.insecure_channel(SOCKET_TARGET)
    stub = SystemFirmwareStub(channel)
    try:
        if args.rollback:
            response = stub.StartRollback(
                RollbackRequest(
                    backup_dir=absolute_path(
                        args.backup_dir[0] if args.backup_dir else ""),
                    legacy_cli=True,
                ), timeout=10)
            if response.ok:
                response = wait_for_operation(
                    stub, response.operation_id, args.quiet, False
                )
        else:
            response = stub.StartUpdate(
                UpdateRequest(
                    firmware_path=absolute_path(args.firmware),
                    backup_dir=absolute_path(
                        args.backup_dir[0] if args.backup_dir else ""),
                    preserve_list=preserve_list,
                    reset=args.reset,
                    no_backup=args.no_backup,
                    force=args.force,
                    verify_signature=args.verify,
                    legacy_cli=True,
                ), timeout=10)
            if response.ok:
                response = wait_for_operation(
                    stub,
                    response.operation_id,
                    args.quiet,
                    not args.no_backup and not args.force,
                )
    except grpc.RpcError as error:
        print(f"System Firmware service unavailable: {error.details()}",
              file=sys.stderr)
        return 8
    except TimeoutError as error:
        print(str(error), file=sys.stderr)
        return 8
    finally:
        channel.close()

    if not response.ok:
        print(response.message, file=sys.stderr)
        if response.code == "flashing-failed":
            print(
                "\n   ====================================\n"
                "   Upgrade Failed! Please do not reboot!!\n"
                "   The Device may become brick.\n"
                "   Please try to rollback!\n"
                "   ====================================",
                file=sys.stderr,
            )
            if not args.quiet:
                print("Hit the Enter Key to Exit:", file=sys.stderr)
                try:
                    input()
                except EOFError:
                    pass
        elif response.code == "rollback-failed":
            print(
                "\n   ====================================\n"
                "   Rollback failed! Please do not reboot!!\n"
                "   The device may become unbootable.\n"
                "   ====================================",
                file=sys.stderr,
            )
        return result_code(response, args.rollback)
    if confirm("\nWarning: Completed. Please reboot the device. Reboot now",
               args.quiet, auto_answer="n"):
        os.system("reboot")
    return result_code(response, args.rollback)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
