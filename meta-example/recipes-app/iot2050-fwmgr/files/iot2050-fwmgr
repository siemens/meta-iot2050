"""Privileged local client for the IOT2050 firmware task core."""

import argparse
import json
import sys
import uuid

from iot2050_fwmgr import (
    FirmwareError,
    FirmwareTaskCore,
    BackendRegistry,
)

def load_manager():
    registry = BackendRegistry()
    registry.discover()
    return FirmwareTaskCore(registry)

def main(argv=None):
    parser = argparse.ArgumentParser(description="IOT2050 firmware backend")
    parser.add_argument("--socket", help=argparse.SUPPRESS)
    subparsers = parser.add_subparsers(dest="operation", required=True)
    subparsers.add_parser("capabilities")
    inspect_parser = subparsers.add_parser("inspect")
    inspect_parser.add_argument("backend")
    inspect_parser.add_argument("--payload", default="{}")
    inspect_parser.add_argument("--rollback", action="store_true")
    rollback_parser = subparsers.add_parser("rollback")
    rollback_parser.add_argument("backend")
    rollback_parser.add_argument("--payload", default="{}")
    start_parser = subparsers.add_parser("start")
    start_parser.add_argument("backend")
    start_parser.add_argument("--payload", default="{}")
    task_parser = subparsers.add_parser("task")
    task_parser.add_argument("task_id")
    staging_list_parser = subparsers.add_parser("staging-list")
    staging_delete_parser = subparsers.add_parser("staging-delete")
    staging_delete_parser.add_argument("token")
    staging_gc_parser = subparsers.add_parser("staging-gc")
    staging_gc_parser.add_argument("--older-than-seconds", type=int, default=86400)
    stage_parser = subparsers.add_parser("stage")
    stage_parser.add_argument("path")
    stage_parser.add_argument("--name")
    worker_parser = subparsers.add_parser("worker", help=argparse.SUPPRESS)
    worker_parser.add_argument("task_id")
    args = parser.parse_args(argv)

    manager = load_manager()
    if args.operation == "worker":
        try:
            task = manager.execute_task(args.task_id)
        except FirmwareError as error:
            print(error.message, file=sys.stderr)
            return 1
        return 0 if task.get("state") == "succeeded" else 1

    try:
        payload = json.loads(getattr(args, "payload", "{}"))
        operation_map = {
            "capabilities": "capabilities.list",
            "inspect": "inspect.get",
            "start": "action.start",
            "rollback": "action.rollback",
            "task": "task.get",
            "staging-list": "staging.list",
            "staging-delete": "staging.delete",
            "staging-gc": "staging.gc",
            "stage": "staging.import",
        }
        request = {
            "v": 1,
            "id": str(uuid.uuid4()),
            "op": operation_map[args.operation],
            "payload": payload,
        }
        if args.operation in ("inspect", "start", "rollback"):
            request["backend"] = args.backend
        if args.operation == "inspect" and args.rollback:
            request["payload"]["operation"] = "rollback"
        if args.operation == "task":
            request["payload"] = {"task_id": args.task_id}
        if args.operation == "staging-delete":
            request["payload"] = {"token": args.token}
        if args.operation == "staging-gc":
            request["payload"] = {"older_than_seconds": args.older_than_seconds}
        if args.operation == "stage":
            request["payload"] = {"path": args.path}
            if args.name:
                request["payload"]["name"] = args.name
        response = manager.handle(request)
    except (OSError, ValueError, FirmwareError) as error:
        print(json.dumps({
            "v": 1,
            "id": None,
            "ok": False,
            "error": {"code": "client-error", "message": str(error)},
        }))
        return 1

    print(json.dumps(response, separators=(",", ":"), sort_keys=True))
    return 0 if response.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
