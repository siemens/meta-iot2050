"""Privileged local client for the IOT2050 firmware manager."""

import argparse
import json
import os
import socket
import sys
import tempfile
import uuid


DEFAULT_SOCKET = "/run/iot2050/firmware-manager.sock"


def request_manager(request, socket_path=DEFAULT_SOCKET):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.connect(socket_path)
        client.sendall((json.dumps(request) + "\n").encode("utf-8"))
        with client.makefile("r", encoding="utf-8") as response:
            return json.loads(response.readline())


def main(argv=None):
    parser = argparse.ArgumentParser(description="IOT2050 firmware manager client")
    parser.add_argument("--socket", default=DEFAULT_SOCKET, help=argparse.SUPPRESS)
    subparsers = parser.add_subparsers(dest="operation", required=True)
    subparsers.add_parser("capabilities")
    inspect_parser = subparsers.add_parser("inspect")
    inspect_parser.add_argument("provider")
    inspect_parser.add_argument("--payload", default="{}")
    start_parser = subparsers.add_parser("start")
    start_parser.add_argument("provider")
    start_parser.add_argument("--payload", default="{}")
    task_parser = subparsers.add_parser("task")
    task_parser.add_argument("task_id")
    stage_parser = subparsers.add_parser("stage")
    stage_parser.add_argument("path", nargs="?", default="-")
    stage_parser.add_argument("--name")
    args = parser.parse_args(argv)

    try:
        payload = json.loads(getattr(args, "payload", "{}"))
        operation_map = {
            "capabilities": "capabilities.list",
            "inspect": "inspect.get",
            "start": "action.start",
            "task": "task.get",
            "stage": "staging.import",
        }
        request = {
            "v": 1,
            "id": str(uuid.uuid4()),
            "op": operation_map[args.operation],
            "payload": payload,
        }
        if args.operation in ("inspect", "start"):
            request["provider"] = args.provider
        if args.operation == "task":
            request["payload"] = {"task_id": args.task_id}
        temporary_path = None
        if args.operation == "stage":
            source_path = args.path
            if source_path == "-":
                with tempfile.NamedTemporaryFile(prefix="iot2050-fwmgr-", delete=False) as temporary:
                    temporary_path = temporary.name
                    os.chmod(temporary_path, 0o600)
                    while True:
                        chunk = sys.stdin.buffer.read(1024 * 1024)
                        if not chunk:
                            break
                        temporary.write(chunk)
                source_path = temporary_path
            request["payload"] = {"path": source_path}
            if args.name:
                request["payload"]["name"] = args.name
        response = request_manager(request, args.socket)
    except (OSError, ValueError) as error:
        print(json.dumps({
            "v": 1,
            "id": None,
            "ok": False,
            "error": {"code": "client-error", "message": str(error)},
        }))
        return 1
    finally:
        if 'temporary_path' in locals() and temporary_path:
            try:
                os.remove(temporary_path)
            except OSError:
                pass

    print(json.dumps(response, separators=(",", ":"), sort_keys=True))
    return 0 if response.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
