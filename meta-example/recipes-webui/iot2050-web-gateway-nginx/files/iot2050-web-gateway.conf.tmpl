map $http_upgrade $iot2050_connection_upgrade {
    default upgrade;
    '' close;
}

# Cockpit keeps its selected language in the CockpitLang cookie. Normalize
# that cookie at the gateway so a browser profile with a previous language
# selection cannot override the English-only runtime policy. Other cookies,
# including authentication and session cookies, are preserved.
map $http_cookie $iot2050_cockpit_cookie {
    default "$http_cookie; CockpitLang=en";
    "" "CockpitLang=en";
    "~*^CockpitLang=[^;]*$" "CockpitLang=en";
    "~*^CockpitLang=[^;]*;\s*$" "CockpitLang=en";
    "~*^(?<iot2050_cookie_before_trailing>.*);\s*CockpitLang=[^;]*;\s*$" "$iot2050_cookie_before_trailing; CockpitLang=en";
    "~*^(?<iot2050_cookie_before_last>.*);\s*CockpitLang=[^;]*$" "$iot2050_cookie_before_last; CockpitLang=en";
    "~*^CockpitLang=[^;]*;\s*(?<iot2050_cookie_after_first>.+)$" "$iot2050_cookie_after_first; CockpitLang=en";
    "~*^(?<iot2050_cookie_before>.+);\s*CockpitLang=[^;]*;\s*(?<iot2050_cookie_after>.+)$" "$iot2050_cookie_before; $iot2050_cookie_after; CockpitLang=en";
}

server {
    listen 80;
    listen [::]:80;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # server_name _ is a catch-all default. The gateway only serves one site,
    # so every Host header is handled the same way.
    server_name _;

    ssl_certificate /etc/iot2050/web-gateway/tls.crt;
    ssl_certificate_key /etc/iot2050/web-gateway/tls.key;
    client_max_body_size 64k;

    location = /oss {
        alias /usr/share/iot2050/oss-clearing/${OSS_ARCHIVE};
        default_type application/zip;
        add_header Content-Disposition 'attachment; filename="${OSS_ARCHIVE}"' always;
    }

    location / {
        # The selected mode injects only the backend port. The TLS listener,
        # redirect, and proxy policy stay identical across onboarding/runtime.
        include /etc/nginx/conf.d/iot2050-web-gateway-mode/current.conf;
        include /etc/nginx/conf.d/iot2050-web-gateway-proxy-common.conf;
        proxy_pass http://127.0.0.1:$iot2050_backend_port;
    }
}
