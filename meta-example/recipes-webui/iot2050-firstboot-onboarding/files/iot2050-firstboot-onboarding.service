[Unit]
Description=IOT2050 first-boot onboarding web service
After=network.target NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=!/var/lib/iot2050-firstboot-onboarding/complete

[Service]
Type=simple
StateDirectory=iot2050-firstboot-onboarding
StateDirectoryMode=0755
ExecStartPre=/usr/lib/iot2050/web-gateway/iot2050-web-gateway-select-mode onboarding --no-reload
ExecStart=/usr/bin/iot2050-firstboot-onboarding
Restart=on-failure
RestartSec=2s
WorkingDirectory=/usr/lib/iot2050/onboarding

[Install]
WantedBy=multi-user.target
