set -eu

update_script=/usr/lib/iot2050/cockpit/update-issue
issue_file=/run/cockpit/active.issue

[ -x "${update_script}" ] || exit 0
"${update_script}" || exit 0
[ -s "${issue_file}" ] || exit 0

# Restart idle serial gettys so they redraw the complete issue banner. Do not
# interrupt a user who is already logged in on a serial console.
for tty in $(cat /sys/class/tty/console/active 2>/dev/null || true); do
	unit="serial-getty@${tty}.service"
	systemctl --quiet is-active "${unit}" || continue
	who | awk -v tty="${tty}" '$2 == tty { found = 1 } END { exit !found }' \
		&& continue
	systemctl try-restart "${unit}" >/dev/null 2>&1 || true
done