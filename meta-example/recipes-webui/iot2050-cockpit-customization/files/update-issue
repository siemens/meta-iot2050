# syntax: update-issue [port [hostname [ipaddr [protocol]]]]
# keep the argument layout for compatibility with cockpit.socket ExecStartPost.
#
# Title depends on onboarding state:
# - before onboarding: "IOT2050 Device Setup"
# - after onboarding:  "IOT2050 Web Console"
#
# This script writes two issue files:
# - /run/cockpit/active.issue: displayed by getty before serial console login.
# - /etc/issue.net:            displayed by PAM before SSH login.

hostname=${2:-$(hostname -f || hostname)}
issue_file=/run/cockpit/active.issue
issue_net_file=/etc/issue.net

# Show every routable IPv4 address instead of a placeholder URL.  Restricting
# the query to global addresses excludes loopback and link-local addresses,
# while retaining addresses on all interfaces that can be reached locally.
network_addresses=$(ip -o -4 addr show scope global 2>/dev/null \
	| awk '{sub(/\/.*/, "", $4); print $4}' \
	| LC_ALL=C sort -u) || true

mkdir -p /run/cockpit
ln -snf active.issue /run/cockpit/issue

# Choose title based on onboarding availability and completion marker.
if [ -f /var/lib/iot2050-firstboot-onboarding/complete ] \
	|| [ ! -x /usr/bin/iot2050-firstboot-onboarding ] \
	|| [ ! -f /usr/lib/systemd/system/iot2050-firstboot-onboarding.service ]; then
	title="IOT2050 Web Console"
else
	title="IOT2050 Device Setup"
fi

# Render the banner once and write to both issue files.
render_banner() {
	printf '%s\n' '----------------------------------------'
	printf '\n'
	printf '%s\n' "${title}"
	printf 'Visit:\n'
	if [ -n "${network_addresses}" ]; then
		printf '%s\n' "${network_addresses}" | while IFS= read -r address; do
			[ -n "${address}" ] || continue
			printf '    https://%s/\n' "${address}"
		done
	else
		printf '    No network address.\n'
		printf '    Connect the device to a network to access the %s.\n' "${title#IOT2050 }"
	fi
	if [ -n "${hostname}" ] && [ "${hostname}" != "localhost" ]; then
		printf '\nHost: %s\n' "${hostname}"
	fi
	printf '\n'
	printf '%s\n' '----------------------------------------'
}

render_banner > "${issue_file}"
render_banner > "${issue_net_file}"
