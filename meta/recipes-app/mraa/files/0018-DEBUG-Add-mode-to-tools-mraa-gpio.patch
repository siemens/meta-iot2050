+                        return -1;
+                    }
+                }
+                if (gpio_get(pin, &level, rawmode, mode) == MRAA_SUCCESS) {
                     fprintf(stdout, "Pin %d = %d\n", pin, level);
                 } else {
                     fprintf(stdout, "Could not initialize gpio %d\n", pin);
