+		reg = <0x25>;
+		interrupt-parent = <&wkup_gpio0>;
+		interrupts = <38 IRQ_TYPE_EDGE_FALLING>;
+		#gpio-cells = <2>;
+		gpio-controller;
+		gpio-line-names =
+			"IO0", "IO1", "IO2", "IO3",	"IO4", "IO5", "IO6", "IO7",
+			"IO8", "IO9", "IO10", "IO11", "IO12", "IO13";
+	};
+};
