+static int fit_image_prepare(const char *fit_image_path,
+			     void **pimage, u32 *pimage_size)
+{
+	ofnode node;
+	u64 loadaddr;
+	u32 size;
+	int ret;
+
+	node = ofnode_path(fit_image_path);
+	if (!ofnode_valid(node))
+		return -ENOENT;
+
+	ret = ofnode_read_u64(node, "load", &loadaddr);
+	if (ret)
+		return ret;
+
+	ret = ofnode_read_u32(node, "size", &size);
+	if (ret)
+		return ret;
+
+	*pimage = map_sysmem(loadaddr, size);
+	*pimage_size = size;
+
+	return 0;
+}
+
+static int maybe_switch_rev_fdtcontroladdr(void)
+{
+	const char *fit_image_path;
+	void *fdt_blob;
+	u32 fdt_size;
+	int total_size;
+	int ret;
+
+	if (!rev_dtb_switch_applicable())
+		return 0;
+
+	if (board_is_m2())
+		fit_image_path = "/fit-images/advanced-m2-rev-dtb";
+	else
+		fit_image_path = "/fit-images/advanced-pg2-rev-dtb";
+
+	ret = fit_image_prepare(fit_image_path, &fdt_blob, &fdt_size);
+	if (ret) {
+		pr_err("IOT2050: Cannot access requested rev DTB metadata %s\n",
+		       fit_image_path);
+		return ret;
+	}
+
+	ret = fdt_check_header(fdt_blob);
+	if (ret) {
+		pr_err("IOT2050: Invalid requested rev DTB at %s (%d)\n",
+		       fit_image_path, ret);
+		return -EINVAL;
+	}
+
+	total_size = fdt_totalsize(fdt_blob);
+	if (total_size <= 0 || total_size > fdt_size) {
+		pr_err("IOT2050: Requested rev DTB size mismatch at %s\n",
+		       fit_image_path);
+		return -EINVAL;
+	}
+
+	env_set_hex("fdtcontroladdr", (unsigned long)map_to_sysmem(fdt_blob));
+
+	return 0;
+}
