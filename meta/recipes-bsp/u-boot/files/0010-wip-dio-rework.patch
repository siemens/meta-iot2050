+static bool board_is_pg2(void)
+{
+	struct iot2050_info *info = IOT2050_INFO_DATA;
+
+	return info->magic == IOT2050_INFO_MAGIC &&
+		strcmp((char *)info->name, "IOT2050-ADVANCED-PG2") == 0;
+}
+
+static bool iot2050_rev_requested(void)
+{
+	return env_get_ulong("iot2050_rev", 10, 0) == 1;
+}
+
+static bool rev_dtb_switch_applicable(void)
+{
+	return iot2050_rev_requested() && (board_is_pg2() || board_is_m2());
+}
+
+static const char *select_fdtfile(bool use_rev)
+{
+	if (board_is_advanced()) {
+		if (board_is_pg1())
+			return "ti/k3-am6548-iot2050-advanced.dtb";
+		if (board_is_m2())
+			return use_rev ?
+				"ti/k3-am6548-iot2050-advanced-m2-rev.dtb" :
+				"ti/k3-am6548-iot2050-advanced-m2.dtb";
+		if (board_is_sm())
+			return "ti/k3-am6548-iot2050-advanced-sm.dtb";
+		if (board_is_pg2())
+			return use_rev ?
+				"ti/k3-am6548-iot2050-advanced-pg2-rev.dtb" :
+				"ti/k3-am6548-iot2050-advanced-pg2.dtb";
+
+		return "ti/k3-am6548-iot2050-advanced-pg2.dtb";
+	}
+
+	if (board_is_pg1())
+		return "ti/k3-am6528-iot2050-basic.dtb";
+
+	return "ti/k3-am6528-iot2050-basic-pg2.dtb";
+}
