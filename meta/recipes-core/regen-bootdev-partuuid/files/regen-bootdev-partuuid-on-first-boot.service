[Unit]
Description=Regenerate GPT partition UUIDs on first boot
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-remount-fs.service expand-on-first-boot.service
Before=sysinit.target shutdown.target
ConditionPathIsReadWrite=/etc

[Service]
Type=simple
RemainAfterExit=yes
ExecStart=/usr/share/regen-bootdev-partuuid/regen-bootdev-partuuid.sh
ExecStartPost=-/bin/systemctl disable regen-bootdev-partuuid-on-first-boot.service

[Install]
WantedBy=sysinit.target
